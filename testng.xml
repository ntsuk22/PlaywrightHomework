<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Playwright Homework Suite" verbose="1">
    <test name="Toolshop Sequential Tests">
        <classes>
            <class name="ge.tbc.testautomation.tests.ToolshopTests"/>
        </classes>
    </test>

    <test name="Toolshop Isolated Tests">
        <classes>
            <class name="ge.tbc.testautomation.tests.IsolatedToolshopTests"/>
        </classes>
    </test>

    <test name="Toolshop E2E Scenarios">
        <classes>
            <class name="ge.tbc.testautomation.tests.GuestCheckoutCompletePurchaseTest"/>
            <class name="ge.tbc.testautomation.tests.UserRegistrationAndLoginFlowTest"/>
            <class name="ge.tbc.testautomation.tests.ContactFormSubmissionTest"/>
        </classes>
    </test>

    <test name="PrestaShop Chromium">
        <parameter name="browser" value="chromium"/>
        <classes>
            <class name="ge.tbc.testautomation.tests.CustomerSupportInquiryTest"/>
        </classes>
    </test>

    <test name="PrestaShop Webkit">
        <parameter name="browser" value="webkit"/>
        <classes>
            <class name="ge.tbc.testautomation.tests.CustomerSupportInquiryTest"/>
        </classes>
    </test>
</suite>
